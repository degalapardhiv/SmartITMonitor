# Smart IT Monitor - environment template
# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=smartadmin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=smart_monitor

# SQLAlchemy connection string (used by the backend directly)
# With Docker Compose use the service name "db" as the host:
DATABASE_URL=postgresql://smartadmin:change_this_password@db:5432/smart_monitor
# For a plain (non-Docker) backend, use localhost instead:
# DATABASE_URL=postgresql://smartadmin:change_this_password@localhost:5432/smart_monitor

# --- JWT ---
# Generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Telegram notifications (optional) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bootstrap admin (optional seeding) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password

# --- CORS (optional) ---
# The deployed frontend is served by nginx on the same origin, so CORS is not
# needed there. Set this ONLY if you serve the frontend from a different origin
# than the API (e.g. a Vite dev server on another machine).
# Comma-separated list, e.g. CORS_ORIGINS=http://10.0.0.10:5173,http://192.168.1.50:5173
CORS_ORIGINS=
