# Smart IT Monitor - Agent environment template (LAN / switch environment)
# Copy to agent/.agent.env (or repo-root .agent.env) and fill in real values.
# Every device that should be monitored runs this agent and uses this file.

# --- Backend connection ---
# Use the LAN IP of the server running the SmartITMonitor stack so agents
# reach it from any switch in the building (not 127.0.0.1).
SMARTIT_API_URL=http://10.0.0.10:8000

# --- Device identity ---
# Register the device once via POST /agent/register or the admin UI,
# then fill in its id and agent token here.
SMARTIT_DEVICE_ID=
SMARTIT_AGENT_TOKEN=

# --- Device info ---
SMARTIT_DEPARTMENT=Computer Science & Engineering
SMARTIT_LAB=Cyber Security Lab
SMARTIT_LOCATION=Block A

# --- Real-time tuning (LAN) ---
# Metrics heartbeat to the server (5s keeps online/offline status live).
SMARTIT_INTERVAL=5

# Device discovery on this subnet. Keep small; nmap ping-sweeps the range.
SMARTIT_NETWORK_DISCOVERY_INTERVAL=60

# IMPORTANT for the central-switch topology: if managed devices live on
# more than one subnet/VLAN behind the switches, list every range here
# (comma separated). Agents scan their own subnet automatically.
# SMARTIT_NETWORK_RANGES=10.0.0.0/24,192.168.1.0/24

# OS deployment: how often the agent checks for a pending reimage.
SMARTIT_DEPLOYMENT_POLL_INTERVAL=15
# When a reimage is accepted the agent reboots the machine into PXE.
# Uncomment on real endpoints (e.g. "systemctl reboot" on Linux).
# SMARTIT_REBOOT_CMD=systemctl reboot

# Endpoint activity upload cadence.
SMARTIT_ACTIVITY_INTERVAL=30

# Software package install/uninstall polling.
SMARTIT_SOFTWARE_POLL_INTERVAL=30

# Web Access Control (allow/block domains) enforcement cadence.
SMARTIT_WEB_ACCESS_POLL_INTERVAL=15
