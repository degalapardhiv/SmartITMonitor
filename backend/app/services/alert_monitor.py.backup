from app.database import SessionLocal
from app.models import Device
from app.alert_model import Alert
import threading
import time


CPU_LIMIT = 90
RAM_LIMIT = 90
DISK_LIMIT = 90


def check_alerts():

    while True:

        db = SessionLocal()

        try:

            devices = db.query(Device).all()

            for device in devices:


                if device.cpu and device.cpu > CPU_LIMIT:

                    create_alert(
                        db,
                        device,
                        "CPU",
                        device.cpu
                    )


                if device.ram and device.ram > RAM_LIMIT:

                    create_alert(
                        db,
                        device,
                        "RAM",
                        device.ram
                    )


                if device.disk and device.disk > DISK_LIMIT:

                    create_alert(
                        db,
                        device,
                        "DISK",
                        device.disk
                    )


        finally:

            db.close()


        time.sleep(30)



def create_alert(db, device, metric, value):

    alert = Alert(

        device_id=device.id,

        message=f"{metric} usage high: {value}%"

    )


    db.add(alert)

    db.commit()



def start_alert_monitor():

    thread = threading.Thread(
        target=check_alerts,
        daemon=True
    )

    thread.start()
