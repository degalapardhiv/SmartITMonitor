# ==========================================
# Dashboard
# ==========================================

@router.get("/dashboard")
def dashboard(
    db: Session = Depends(get_db)
):

    devices = db.query(Device).all()

    total = len(devices)

    online = len(
        [
            d
            for d in devices
            if d.status == "Online"
        ]
    )

    offline = total - online

    alerts = len(
        [
            d
            for d in devices
            if (
                d.cpu > 90
                or d.ram > 90
                or d.disk > 90
            )
        ]
    )

    departments = len(
        set(
            d.department
            for d in devices
            if d.department
        )
    )

    labs = len(
        set(
            d.lab
            for d in devices
            if d.lab
        )
    )

    return {
        "total": total,
        "online": online,
        "offline": offline,
        "alerts": alerts,
        "departments": departments,
        "labs": labs,
    }

