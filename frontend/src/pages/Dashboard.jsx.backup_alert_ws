import { useEffect, useState } from "react";
import Layout from "../components/layout/Layout";
import useWebSocket from "../hooks/useWebSocket";
import api from "../services/api";
import DeviceChart from "../components/charts/DeviceChart";
import LiveDevices from "../components/devices/LiveDevices";

function Dashboard() {

  const liveData = useWebSocket();

  const [liveDevice, setLiveDevice] = useState(null);

  const [history, setHistory] = useState([]);

  const [stats, setStats] = useState({
    total: 0,
    online: 0,
    offline: 0,
    alerts: 0,
    departments: 0,
    labs: 0,
  });


  useEffect(() => {

    if (
      liveData &&
      liveData.type === "device_update"
    ) {

      console.log(
        "New Device Data:",
        liveData.device
      );

      setLiveDevice(
        liveData.device
      );

      setHistory(prev => [
        ...prev.slice(-19),
        {
          time: new Date().toLocaleTimeString(),
          cpu: liveData.device.cpu,
          ram: liveData.device.ram,
          disk: liveData.device.disk
        }
      ]);

      loadDashboard();

    }

  }, [liveData]);


  useEffect(() => {

    loadDashboard();

  }, []);


  async function loadDashboard() {

    try {

      const response = await api.get("/dashboard");

      setStats(response.data);

    } catch (err) {

      console.error(
        "Dashboard Error:",
        err
      );

    }

  }


  return (

    <Layout>

      <div className="mb-8">

        <h1 className="text-4xl font-bold text-white">
          Dashboard
        </h1>

        <p className="text-gray-400 mt-2">
          Smart IT Monitor Overview
        </p>

      </div>


      <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">


        <Card title="Total Devices" value={stats.total}/>

        <Card title="Online Devices" value={stats.online}/>

        <Card title="Offline Devices" value={stats.offline}/>

        <Card title="Alerts" value={stats.alerts}/>

        <Card title="Departments" value={stats.departments}/>

        <Card title="Labs" value={stats.labs}/>


      </div>


      <div className="mt-8">

        <h2 className="text-2xl font-bold text-white mb-4">
          Live Device Monitor
        </h2>


        {liveDevice ? (

          <div className="bg-slate-800 rounded-xl p-6">

            <h3 className="text-cyan-400 text-2xl">
              {liveDevice.hostname}
            </h3>


            <div className="grid grid-cols-3 gap-5 mt-5">


              <div>
                CPU
                <p className="text-3xl text-green-400">
                  {liveDevice.cpu}%
                </p>
              </div>


              <div>
                RAM
                <p className="text-3xl text-yellow-400">
                  {liveDevice.ram}%
                </p>
              </div>


              <div>
                Disk
                <p className="text-3xl text-purple-400">
                  {liveDevice.disk}%
                </p>
              </div>


            </div>


            <p className="mt-5 text-green-400">
              Status: {liveDevice.status}
            </p>


          </div>


        ) : (

          <p className="text-gray-400">
            Waiting for live device data...
          </p>

        )}


      </div>


      <LiveDevices />

          <DeviceChart data={history} />

      <DeviceChart data={history} />

    </Layout>

  );

}


function Card({title,value}) {

  return (

    <div className="bg-slate-800 rounded-xl p-6 shadow-lg">

      <h2 className="text-gray-400">
        {title}
      </h2>

      <p className="text-5xl font-bold text-cyan-400 mt-3">
        {value}
      </p>

    </div>

  );

}


export default Dashboard;
