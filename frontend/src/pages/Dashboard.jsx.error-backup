import { useEffect, useState } from "react";
import Layout from "../components/layout/Layout";
import useWebSocket from "../hooks/useWebSocket";
import api from "../services/api";

function Dashboard() {
\n  const liveData = useWebSocket();
\n  console.log("Live Update:", liveData);


  const [stats, setStats] = useState({
    total: 0,
    online: 0,
    offline: 0,
    alerts: 0,
    departments: 0,
    labs: 0,
  });

  useEffect(() => {
    loadDashboard();
  }, []);

  async function loadDashboard() {
    try {
      const response = await api.get("/dashboard");
      setStats(response.data);
    } catch (err) {
      console.error("Dashboard Error:", err);
    }
  }

  return (
    <Layout>
      <div className="mb-8">
        <h1 className="text-4xl font-bold text-white">
          Dashboard
        </h1>

        <p className="text-gray-400 mt-2">
          Smart IT Monitor Overview
        </p>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

        <div className="bg-slate-800 rounded-xl p-6 shadow-lg">
          <h2 className="text-gray-400">Total Devices</h2>

          <p className="text-5xl font-bold text-cyan-400 mt-3">
            {stats.total}
          </p>
        </div>

        <div className="bg-slate-800 rounded-xl p-6 shadow-lg">
          <h2 className="text-gray-400">Online Devices</h2>

          <p className="text-5xl font-bold text-green-400 mt-3">
            {stats.online}
          </p>
        </div>

        <div className="bg-slate-800 rounded-xl p-6 shadow-lg">
          <h2 className="text-gray-400">Offline Devices</h2>

          <p className="text-5xl font-bold text-red-400 mt-3">
            {stats.offline}
          </p>
        </div>

        <div className="bg-slate-800 rounded-xl p-6 shadow-lg">
          <h2 className="text-gray-400">Alerts</h2>

          <p className="text-5xl font-bold text-yellow-400 mt-3">
            {stats.alerts}
          </p>
        </div>

        <div className="bg-slate-800 rounded-xl p-6 shadow-lg">
          <h2 className="text-gray-400">Departments</h2>

          <p className="text-5xl font-bold text-purple-400 mt-3">
            {stats.departments}
          </p>
        </div>

        <div className="bg-slate-800 rounded-xl p-6 shadow-lg">
          <h2 className="text-gray-400">Labs</h2>

          <p className="text-5xl font-bold text-orange-400 mt-3">
            {stats.labs}
          </p>
        </div>

      </div>
    </Layout>
  );
}

export default Dashboard;
